# True or False depending on whether you want to use AWS Bedrock Mantle Endpoint or OpenAI API
USE_AWS_BEDROCK=

# include the region in the base url, like https://bedrock-mantle.us-east-1.api.aws/v1
AWS_BEDROCK_BASE_URL=
AWS_BEDROCK_API_KEY=

# moonshotai.kimi-k2.5 is a good choice
AWS_BEDROCK_MODEL_ID= 

#populate this if using OpenAI API
OPENAI_API_KEY=

# Anything gpt 5.6-luna or above will work well
OPENAI_API_MODEL=gpt-5.6-luna

# Hard limits you can set for how many executor agents can be set per task, and how many task sets can be run per orchestration run
MAX_EXECUTOR_AGENTS_PER_TASK_SET=2
MAX_TASK_SETS_PER_ORCHESTRATION=3

# Database URIs for the Django Application
POSTGRES_URI=
REDIS_URI=